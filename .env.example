# Copy to .env (never commit .env). All keys stay server-side.
SARVAM_API_KEY=
FLAGSMITH_ENVIRONMENT_KEY=          # Server-side environment key
FLAGSMITH_API_URL=                  # optional; defaults to Flagsmith edge API
NUDGEBEE_WEBHOOK_URL=               # optional; incident signal target
DATABASE_URL=sqlite:///./pheras.db

# Demo-only switches
ALLOW_DEMO_ADMIN=1                  # enables /admin/simulate-sarvam-failure and /admin/seed-partner-b
SELF_HEAL_FALLBACK=0                # 1 = LAST-RESORT: app flips voice off itself when breaker opens (label honestly)
